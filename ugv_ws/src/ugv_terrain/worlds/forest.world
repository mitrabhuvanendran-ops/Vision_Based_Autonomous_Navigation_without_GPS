<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.65 0.62 0.58 1.0</ambient>
      <background>0.72 0.82 0.94 1.0</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <include><uri>model://sun</uri></include>

    <!-- Publishes real ground-truth /model_states so dataset generators
         and the costmap can project actual obstacle poses instead of
         a guessed/hardcoded database. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <!-- Canyon Basin Surface -->
    <model name="canyon_terrain">
      <static>true</static>
      <link name="link">
        <!-- NOTE: this was a <heightmap> geometry (canyon_heightmap.png, up to
             18m relief) per the original Stage 3 spec. Gazebo Classic's Ogre
             terrain/heightmap subsystem on this host floods "Image:
             Coordinates out of range" errors continuously and, over a few
             minutes of sustained runtime, that error-logging volume appears
             to starve gzserver's simulation loop entirely - every topic,
             including physics-only ones like /odom, stops publishing. That
             breaks every stage needing sustained operation (dataset
             collection, safety testing). Swapped to a flat plane so the sim
             is actually usable; real elevation relief should come back via
             a mesh-based terrain (.dae/.obj with baked heightfield geometry)
             instead of Gazebo Classic's heightmap code path, which renders
             through the normal entity pipeline and avoids this bug. -->
        <collision name="col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>140 140</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>140 140</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.60 0.42 1.0</ambient>
            <diffuse>0.75 0.60 0.42 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

